# MindGraph Configuration — replace all values with your domain settings

domain: "my-knowledge-base"
language: "en"

llm:
  provider: anthropic          # openai | gemini | anthropic
  model: claude-sonnet-4-6
  api_key_env: ANTHROPIC_API_KEY

embedding:
  provider: gemini             # openai | gemini
  model: gemini-embedding-001
  api_key_env: GEMINI_API_KEY

database:
  host: postgres               # Docker service name; use localhost for local dev
  port: 5432
  name: mindgraph
  user: mindgraph
  password_env: MINDGRAPH_DB_PASSWORD

server:
  rest_port: 8401
  mcp_port: 8400
  cors_origins: []             # [] = no CORS (safe default). Never use "*" without an auth layer.

adapters:
  - type: filesystem
    source: ./raw/notes
    target: raw/notes

# Recency: newer knowledge ranks first within a topic (keys = wiki folder names)
recency:
  enabled: true
  base_lambda: 0.003
  floor: 0.5
  category_ratio:
    failure-modes: 0
    decisions: 0
  evergreen: []

# Decision-point recall for Claude Code hooks (`mindgraph hook ...`)
recall:
  api_url: http://127.0.0.1:8401
  failure_categories: [failure-modes]
  max_inject: 6
  min_score: 0.55
